<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.arabic.amount.words</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='total_amount_words']" position="after">
                <setting id="arabic_amount_words_wrap" company_dependent="1"
                         help="Write the Arabic amount as فقط ... لا غير">
                    <field name="arabic_amount_words_wrap"/>
                </setting>
                <setting id="arabic_amount_words_bilingual" company_dependent="1"
                         help="Also print the amount in Arabic words on invoices printed in another language">
                    <field name="arabic_amount_words_bilingual"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
