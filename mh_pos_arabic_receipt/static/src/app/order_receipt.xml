<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- The Arabic text is already bilingual, so none of it is translated: an Arabic POS would print العميل / العميل. -->
    <t t-name="mh_pos_arabic_receipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="after">
            <div t-if="props.data.arabicCustomer" class="pos-receipt-ar-customer text-center mb-2" t-translation="off">
                <!-- bdi keeps the Arabic label and the value from reordering each other, so a phone prints as +20 100 ... -->
                <div>Customer / <bdi>العميل</bdi>: <bdi t-esc="props.data.arabicCustomer.name"/></div>
                <div t-if="props.data.arabicCustomer.phone">Phone / <bdi>الهاتف</bdi>: <bdi dir="ltr" t-esc="props.data.arabicCustomer.phone"/></div>
            </div>
        </xpath>
        <xpath expr="//Orderline" position="inside">
            <t t-set-slot="product-name">
                <div t-if="line.arabicName" class="pos-receipt-ar-name fw-normal text-wrap" dir="rtl" lang="ar">
                    <t t-esc="line.arabicName"/>
                </div>
            </t>
        </xpath>
        <xpath expr="//span[@t-esc='props.formatCurrency(props.data.amount_total)']" position="before">
            <span t-if="props.data.arabicLabels" t-translation="off">/ الإجمالي</span>
        </xpath>
        <xpath expr="//span[@t-esc='props.formatCurrency(props.data.rounding_applied)']" position="before">
            <span t-if="props.data.arabicLabels" t-translation="off">/ التقريب</span>
        </xpath>
        <xpath expr="//span[@t-esc='props.formatCurrency(props.data.change)']" position="before">
            <span t-if="props.data.arabicLabels" t-translation="off">/ الباقي</span>
        </xpath>
        <xpath expr="//span[@t-esc='props.formatCurrency(props.data.total_discount)']" position="before">
            <span t-if="props.data.arabicLabels" t-translation="off">/ الخصومات</span>
        </xpath>
        <xpath expr="//t[@t-if='props.data.rounding_applied']" position="after">
            <div t-if="props.data.arabicAmount" class="pos-receipt-ar-amount text-center my-1" dir="rtl" lang="ar">
                <t t-esc="props.data.arabicAmount"/>
            </div>
        </xpath>
    </t>

</templates>
