<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.arabic.receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="ar_receipt_labels" help="Add the Arabic word next to Total, Change, Discounts and Rounding">
                    <field name="pos_ar_receipt_labels"/>
                </setting>
                <setting id="ar_receipt_product_names" help="Print each product's Arabic translation under its name">
                    <field name="pos_ar_receipt_product_names"/>
                </setting>
                <setting id="ar_receipt_amount_words" help="Print the total in Arabic words: فقط ... لا غير">
                    <field name="pos_ar_receipt_amount_words"/>
                </setting>
                <setting id="ar_receipt_customer" help="Print the customer's phone under the name when the order has a customer">
                    <field name="pos_ar_receipt_customer"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
