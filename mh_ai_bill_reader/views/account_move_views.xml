<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_mh_ai_bill" model="ir.ui.view">
        <field name="name">account.move.form.mh.ai.bill.reader</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post'][last()]" position="after">
                <button name="action_mh_ai_read_bill" string="Read with AI" type="object"
                        class="btn-secondary" icon="fa-magic" groups="account.group_account_invoice"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund', 'in_receipt') or invoice_line_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
