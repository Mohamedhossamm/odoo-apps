<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Same markup and classes as Odoo 16's search view, so it looks native in every theme. -->
    <t t-name="mh_x2many_search.X2ManySearchBar" owl="1">
        <div class="o_x2m_search o_cp_searchview d-flex flex-grow-1" role="search">
            <div class="o_searchview pb-1 align-self-center border-bottom flex-grow-1 position-relative" role="search" aria-autocomplete="list">
                <i class="o_searchview_icon oi oi-search me-2" role="img"/>
                <div class="o_searchview_input_container">
                    <t t-foreach="props.facets" t-as="facet" t-key="facet_index">
                        <div class="o_searchview_facet" role="img" aria-label="search">
                            <span class="o_searchview_facet_label" t-esc="facet.label"/>
                            <div class="o_facet_values border-start-0">
                                <t t-foreach="facet.values" t-as="value" t-key="value_index">
                                    <span t-if="!value_first" class="o_facet_values_sep">or</span>
                                    <span class="o_facet_value" t-esc="value"/>
                                </t>
                            </div>
                            <i class="o_facet_remove oi oi-close btn btn-link opacity-50 opacity-100-hover text-900"
                               role="img" aria-label="Remove" title="Remove" t-on-click="() => this.removeFacet(facet)"/>
                        </div>
                    </t>
                    <input type="text" t-ref="input"
                           class="o_searchview_input"
                           placeholder="Search lines..."
                           role="searchbox"
                           t-model="state.query"
                           t-on-input="onInput"
                           t-on-keydown="onKeydown"
                           t-on-focus="onFocus"
                           t-on-blur="onBlur"/>
                    <ul t-if="items.length" class="dropdown-menu o_searchview_autocomplete show" role="menu">
                        <li t-foreach="items" t-as="item" t-key="item.id"
                            class="o_menu_item dropdown-item"
                            t-att-class="{ focus: item_index === state.focusedIndex }"
                            t-on-mousedown.prevent="() => this.select(item)"
                            t-on-mousemove="() => state.focusedIndex = item_index">
                            <a href="#" t-on-click.prevent="">
                                Search <b t-if="item.names" t-esc="item.label"/><b t-else="">all columns</b> for: <b class="fst-italic text-primary" t-esc="item.query"/>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </t>

    <t t-name="mh_x2many_search.X2ManyField" t-inherit="web.X2ManyField" t-inherit-mode="extension" owl="1">
        <!-- First in the control panel, on the same row as the pager. -->
        <xpath expr="//div[hasclass('o_x2m_control_panel')]/t[1]" position="before">
            <div t-if="showX2mSearch" class="o_x2m_search_panel d-flex flex-grow-1 align-items-center gap-2 me-3">
                <t t-component="x2mSearchBar" columns="x2mSearchColumns" facets="x2mSearch.facets" onChange.bind="onX2mSearchChange"/>
                <small t-if="x2mSearch.facets.length" class="o_x2m_search_count text-muted text-nowrap">
                    <t t-esc="x2mSearchMatchCount"/> / <t t-esc="list.count"/>
                </small>
            </div>
        </xpath>
    </t>

</templates>
